# ─── The Fordism — environment config ────────────────────────────────
# Copy to `.env` and fill in. The whole stack is GPU-free and identical on
# every host; the only per-host thing is the Ollama GPU host (OLLAMA_BASE_URL).
# `.env` is git-ignored — never commit real secrets.

# --- Images / deploy ---
REGISTRY=ghcr.io/mcark/fordism
TAG=latest
WEB_PORT=80

# --- Storage ---
# The per-env root bind-mounted at /fordism: workspaces, state, workflows,
# templates, skills, agent-profiles and credentials all live under it.
FORDISM_ROOT=/var/lib/fordism

# --- Launcher ---
# The docker network the spawned agent containers join. It must be one they can
# reach core on — normally this compose project's `internal` (e.g. uat_internal).
FORDISM_LAUNCHER_NETWORK=
FORDISM_AGENT_IMAGE=fordism/fordism-agent:local
FORDISM_LAUNCHER_MAX=4

# --- LLM ────────────────────────────────────────────────────────────
# No gateway — agents call providers directly via each Agent Profile's baseUrl.
# OLLAMA_BASE_URL is the default backend when a task resolves no profile.
OLLAMA_BASE_URL=http://<gpu-host>:11434     # only needed if you use a local-model profile
AGENT_MODEL=qwen3
# Provider keys live per Agent Profile in the Fordism UI (write-only), not here.
# Credentials an agent needs (GITHUB_TOKEN, …) live on the Credentials page and
# are granted per Agent Template — not in this file.

# --- Auth (optional) ────────────────────────────────────────────────
# Empty = auth off; run Fordism only on a network you trust. To require login,
# point these at your OIDC identity provider: its RS256 public key (PEM), the
# exact `iss` claim it mints, and (recommended) the `aud` for this service.
FORDISM_AUTH_PUBKEY=
FORDISM_AUTH_ISSUER=
FORDISM_AUTH_AUDIENCE=
