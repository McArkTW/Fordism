# ─── The Fordism — environment config ────────────────────────────────
# Copy to `.env` and fill in. The whole stack is GPU-free and identical on
# every host; the only per-host thing is the Ollama GPU host (OLLAMA_BASE_URL).
# `.env` is git-ignored — never commit real secrets.

# --- Images / deploy ---
REGISTRY=ghcr.io/mcark/fordism
TAG=latest
WEB_PORT=80

# --- Storage ---
# The per-env root bind-mounted at /fordism: workspaces, state, workflows,
# templates, skills, agent-profiles and credentials all live under it.
FORDISM_ROOT=/var/lib/fordism

# --- Launcher ---
# The docker network the spawned agent containers join. It must be one they can
# reach core on — normally this compose project's `internal` (e.g. uat_internal).
FORDISM_LAUNCHER_NETWORK=fordism_internal
# Must match REGISTRY/TAG above — both the compose build and the release produce this name.
FORDISM_AGENT_IMAGE=ghcr.io/mcark/fordism/fordism-agent:latest
FORDISM_LAUNCHER_MAX=4

# --- LLM ────────────────────────────────────────────────────────────
# No gateway — agents call providers directly via each Agent Profile's baseUrl.
# OLLAMA_BASE_URL is the default backend when a task resolves no profile.
# OLLAMA_BASE_URL=http://your-gpu-host:11434   # only needed if you use a local-model profile
AGENT_MODEL=qwen3
# Provider keys live per Agent Profile in the Fordism UI (write-only), not here.
# Credentials an agent needs (GITHUB_TOKEN, …) live on the Credentials page and
# are granted per Agent Template — not in this file.

# --- Auth ───────────────────────────────────────────────────────────
# Auth is always on. Local accounts are enabled by default; on first visit the UI
# asks for FORDISM_ADMIN_SECRET once to create the admin account — after that the
# secret is inert (rotating it does not reopen bootstrap).
FORDISM_AUTH_LOCAL=true
FORDISM_ADMIN_SECRET=change-me-before-first-boot
# Base URL operators reach Fordism on; used to build OAuth redirect URIs.
FORDISM_PUBLIC_URL=http://localhost
# Set true when serving over HTTPS — a Secure cookie is dropped over plain HTTP.
FORDISM_COOKIE_SECURE=false
# Optional OAuth sign-in. Register an OAuth app whose callback is
# <FORDISM_PUBLIC_URL>/api/auth/<provider>/callback, then fill these in.
# FORDISM_AUTH_GOOGLE_CLIENT_ID=
# FORDISM_AUTH_GOOGLE_CLIENT_SECRET=
# FORDISM_AUTH_GITHUB_CLIENT_ID=
# FORDISM_AUTH_GITHUB_CLIENT_SECRET=
# An OAuth login maps to an existing user; otherwise it is auto-enrolled with no
# permissions only when the email matches one of these comma-separated lists.
# FORDISM_AUTH_ALLOWED_EMAILS=
# FORDISM_AUTH_ALLOWED_DOMAINS=
