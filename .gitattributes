# Normalize line endings
* text=auto eol=lf
*.ps1 text eol=crlf

# Git LFS for binary assets (installers, DLLs) if any are added later
*.exe filter=lfs diff=lfs merge=lfs -text
*.msi filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# Gradle wrapper jar must NOT be LFS
**/gradle-wrapper.jar -filter -diff -merge -text

# Vendored jars are binary (never normalize)
*.jar binary
