# UAT environment — copy to envs/uat.env (git-ignored) and fill in.
# The live file is jenkins-owned at /var/lib/jenkins/fordism-envs/uat.env, 600.
# Deployed automatically on every push to main.
REGISTRY=fordism            # images are built on the box, not pulled
TAG=local
WEB_PORT=8088
FORDISM_ROOT=/var/lib/fordism/uat
FORDISM_LAUNCHER_NETWORK=uat_internal
FORDISM_AGENT_IMAGE=fordism/fordism-agent:local
FORDISM_LAUNCHER_MAX=10
AGENT_MODEL=qwen3
OLLAMA_BASE_URL=http://<gpu-host>:11434
