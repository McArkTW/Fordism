# UAT environment — copy to envs/uat.env (git-ignored) and fill in.
# The live file is jenkins-owned at /var/lib/jenkins/foundry-envs/uat.env, 600.
# Deployed automatically on every push to main.
REGISTRY=foundry            # images are built on the box, not pulled
TAG=local
WEB_PORT=8088
FOUNDRY_ROOT=/var/lib/foundry/uat
FOUNDRY_LAUNCHER_NETWORK=uat_internal
FOUNDRY_AGENT_IMAGE=foundry/foundry-agent:local
FOUNDRY_LAUNCHER_MAX=10
AGENT_MODEL=qwen3
OLLAMA_BASE_URL=http://<gpu-host>:11434
