# PRD environment — copy to envs/prd.env (git-ignored) and fill in; keep the live file 600.
# Run deploy/scripts/deploy.sh prd by hand or from your own runner.
DEPLOY_MODE=build           # pull (registry images) | build (on the box)
REGISTRY=fordism            # images are built on the box, not pulled
TAG=local
WEB_PORT=8087
FORDISM_ROOT=/var/lib/fordism/prd
FORDISM_LAUNCHER_NETWORK=prd_internal
FORDISM_AGENT_IMAGE=fordism/fordism-agent:local
FORDISM_LAUNCHER_MAX=4
AGENT_MODEL=qwen3
OLLAMA_BASE_URL=http://<gpu-host>:11434

# Auth — local login is always on; add an OAuth pair to enable that provider.
FORDISM_AUTH_LOCAL=true
#FORDISM_AUTH_GOOGLE_CLIENT_ID=
#FORDISM_AUTH_GOOGLE_CLIENT_SECRET=     # secret — never commit the live file
#FORDISM_AUTH_GITHUB_CLIENT_ID=
#FORDISM_AUTH_GITHUB_CLIENT_SECRET=     # secret — never commit the live file
#FORDISM_AUTH_MICROSOFT_CLIENT_ID=      # Entra app registration (Application/client ID)
#FORDISM_AUTH_MICROSOFT_CLIENT_SECRET=  # secret — never commit the live file
#FORDISM_AUTH_MICROSOFT_TENANT_ID=      # the tenant's DIRECTORY id (a GUID) — not "common"
#FORDISM_AUTH_ALLOWED_EMAILS=           # comma-separated allowlist of sign-in emails
#FORDISM_AUTH_ALLOWED_DOMAINS=          # comma-separated allowlist of email domains
#FORDISM_ADMIN_SECRET=                  # secret — bootstrap admin credential
FORDISM_PUBLIC_URL=https://<host>      # external URL; OAuth callbacks derive from it
FORDISM_COOKIE_SECURE=true             # true for TLS deployments
FORDISM_TRUSTED_PROXY=true             # keys the login rate-limiter on X-Forwarded-For
