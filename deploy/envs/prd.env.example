# PRD environment — copy to envs/prd.env (git-ignored) and fill in.
# Copy to envs/prd.env (git-ignored) and fill in; keep the live file 600.
# Deployed by a git TAG (vX.Y.Z); cutting the tag is the deploy decision.
REGISTRY=fordism            # images are built on the box, not pulled
TAG=local
WEB_PORT=8087
FORDISM_ROOT=/var/lib/fordism/prd
FORDISM_LAUNCHER_NETWORK=prd_internal
FORDISM_AGENT_IMAGE=fordism/fordism-agent:local
FORDISM_LAUNCHER_MAX=4
AGENT_MODEL=qwen3
OLLAMA_BASE_URL=http://<gpu-host>:11434
