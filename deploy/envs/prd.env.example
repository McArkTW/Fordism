# PRD environment — copy to envs/prd.env (git-ignored) and fill in.
# The live file is jenkins-owned at /var/lib/jenkins/foundry-envs/prd.env, 600.
# Deployed by a git TAG (vX.Y.Z); cutting the tag is the deploy decision.
REGISTRY=foundry            # images are built on the box, not pulled
TAG=local
WEB_PORT=8087
FOUNDRY_ROOT=/var/lib/foundry/prd
FOUNDRY_LAUNCHER_NETWORK=prd_internal
FOUNDRY_AGENT_IMAGE=foundry/foundry-agent:local
FOUNDRY_LAUNCHER_MAX=4
AGENT_MODEL=qwen3
OLLAMA_BASE_URL=http://<gpu-host>:11434
