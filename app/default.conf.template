# fordism-app edge.
#   /api  → fordism-core, which gates every route itself; this proxy only has to be
#           same-origin so the session cookie rides along without CORS in the way
#   /     → the static Angular SPA (client-side routing → index.html fallback)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://fordism-core:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
